# Phase 2 Delivery Tracker — environment configuration
# Copy this file to .env and fill in your values. .env is git-ignored.
#
# IMPORTANT: DB_* must point at the SAME database sor-system uses. This app
# authenticates against sor-system's `users` table — it does not have its
# own account store — so login only works if it's really the same database.

APP_ENV=local
APP_URL=http://localhost:8888/phase-two

# ─── Shared database (same as sor-system) ─────────────────
DB_HOST=localhost
DB_PORT=8889
DB_NAME=sor_management
DB_USER=root
DB_PASS=root

SESSION_SECRET=change_this_secret_in_production

# ─── Authorization ─────────────────────────────────────────
# Comma-separated sor-system usernames who get admin (create/edit) rights in
# THIS app. Everyone else with a valid shared login is view-only. This is
# deliberately separate from sor-system's own users.app_role.
PM_ADMIN_USERNAMES=

# ─── Cross-links (optional) ─────────────────────────────────
# Footer links to the other apps in the suite — same pattern sor-system uses.
# ERC_SITE_URL / ASIS_SITE_URL / METRICS_SITE_URL default to the same live
# URLs sor-system already points at, so you only need to set these locally
# if you want the footer to point somewhere else.
SOR_SYSTEM_URL=http://localhost:8888/sor-system
# ERC_SITE_URL=
# ASIS_SITE_URL=
# METRICS_SITE_URL=
